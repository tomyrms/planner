# Generate private local values with npm run setup:local.
NODE_ENV=development
HOST=127.0.0.1
PORT=4317
POSTGRES_PASSWORD=replace-with-random-admin-password
PLANNER_API_PASSWORD=replace-with-random-api-password
DATABASE_URL=postgresql://planner_api:replace@127.0.0.1:55437/planner
DATABASE_ADMIN_URL=postgresql://planner_owner:replace@127.0.0.1:55437/planner
AUTH_ISSUER=http://localhost:4317
AUTH_API_AUDIENCE=planner-api
AUTH_SYNC_AUDIENCE=planner-sync
AUTH_KEY_ID=planner-local-1
AUTH_PRIVATE_KEY_PATH=.local/auth-private.pem
AUTH_PUBLIC_KEY_PATH=.local/auth-public.pem
AUTH_REFRESH_DERIVATION_KEY=replace-with-32-random-bytes-in-hex
# Oldest iPhone app version allowed to upload changes (426 CLIENT_TOO_OLD below it).
MIN_CLIENT_VERSION=0.1.0
# PowerSync (step 2): replication role, bucket-storage role, public sync URL.
PLANNER_POWERSYNC_PASSWORD=replace-with-random-replication-password
PLANNER_POWERSYNC_STORAGE_PASSWORD=replace-with-random-storage-password
POWERSYNC_URL=http://127.0.0.1:4318
# Assistant (step 3). Without DEEPSEEK_API_KEY, development uses the rule-based stand-in; production is disabled.
# ASSISTANT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
ASSISTANT_MONTHLY_TOKEN_BUDGET=3000000
