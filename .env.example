# Generate private local values with npm run setup:local.
NODE_ENV=development
HOST=127.0.0.1
PORT=4317
POSTGRES_PASSWORD=replace-with-random-admin-password
PLANNER_API_PASSWORD=replace-with-random-api-password
DATABASE_URL=postgresql://planner_api:replace@127.0.0.1:55437/planner
DATABASE_ADMIN_URL=postgresql://planner_owner:replace@127.0.0.1:55437/planner
AUTH_ISSUER=http://localhost:4317
AUTH_API_AUDIENCE=planner-api
AUTH_SYNC_AUDIENCE=planner-sync
AUTH_KEY_ID=planner-local-1
AUTH_PRIVATE_KEY_PATH=.local/auth-private.pem
AUTH_PUBLIC_KEY_PATH=.local/auth-public.pem
AUTH_REFRESH_DERIVATION_KEY=replace-with-32-random-bytes-in-hex
