        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "type": "object",
                "properties": {
                  "pairingSecret": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "device": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "platform": {
                        "type": "string",
                        "const": "ios"
                      },
                      "osVersion": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50
                      },
                      "appVersion": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50
                      }
                    },
                    "required": [
                      "name",
                      "platform",
                      "osVersion",
                      "appVersion"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "pairingSecret",
                  "device"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
