    "/api/v1/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "scope",
                    "database",
                    "sync"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "ready",
                        "not_ready"
                      ],
                      "type": "string"
                    },
                    "scope": {
                      "const": "backend-foundation",
                      "type": "string"
                    },
                    "database": {
                      "enum": [
                        "ready",
                        "unavailable"
                      ],
                      "type": "string"
                    },
                    "sync": {
                      "const": "not_installed",
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
